PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/siddhant_high_school

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

